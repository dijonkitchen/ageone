#!/usr/bin/env node
// Run the pi version pinned in harness/models.json, installing it on first use.
// In this repo, .pi/settings.json loads harness/gateway-options.ts, which adds the active gateway's privacy and host
// options to each request. Apply the OpenRouter routing to your own pi once with:
//   harness/sync --agent-dir ~/.pi/agent
import { spawnSync } from "node:child_process";
import { ensureTool, loadConfig } from "./config.mjs";

const bin = ensureTool(loadConfig().harnesses.pi);
const { status } = spawnSync(bin, process.argv.slice(2), { stdio: "inherit" });
process.exit(status ?? 1);
